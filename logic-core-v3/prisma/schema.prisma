generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ORG_MEMBER
  CLIENT
  SETTER
}

enum OrgRole {
  ADMIN
  MEMBER
  VIEWER
}

enum ServiceType {
  WEB_DEV
  AI
  AUTOMATION
  SOFTWARE
}

enum ServiceStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum ApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum NotificationType {
  ACTION_REQUIRED
  INFO
  SUCCESS
  WARNING
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketCategory {
  TECHNICAL
  BILLING
  FEATURE_REQUEST
  OTHER
}

enum AssetType {
  DOCUMENT
  IMAGE
  BRANDBOOK
  LOGO
  ACCESS
  OTHER
}

enum OnboardingTaskCategory {
  SETUP
  DATA_CONNECTIONS
  CONTENT
  TRAINING
  GO_LIVE
}

enum OnboardingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum NotificationMode {
  IMMEDIATE
  DAILY_DIGEST
  DISABLED
}

enum BotAlertSeverity {
  CRITICAL
  HIGH
  WARNING
  INFO
}

enum BotAlertStatus {
  PENDING
  ACKNOWLEDGED
  RESOLVED
}

enum BotAlertType {
  QUOTA_EXHAUSTED
  LLM_PROVIDER_ERROR
  BOT_INACTIVE_WITH_TRAFFIC
  LATENCY_DEGRADED
  CRON_INSIGHTS_FAILED
  ACTIVITY_ERRORS_SPIKE
  CLIENT_NO_ACTIVITY
  DOMAIN_NOT_AUTHORIZED_SPIKE
  LEAD_CAPTURE_FAILURE
}

// B11.4 — string → enum (5 campos del módulo chatbot)
enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ChatbotLeadIntent {
  PURCHASE_READY
  SCHEDULE_VISIT
  QUOTE_REQUEST
  HUMAN_REQUEST
  SUPPORT
  OTHER
  // Legacy pre-B5.1 — mantenidos en el enum para no romper rows existentes.
  QUOTE
  INFO
  DEMO
}

enum ChatbotEventLevel {
  INFO
  WARN
  ERROR
  DEBUG
}

enum BotIntensityLevel {
  LOW
  MEDIUM
  HIGH
}

enum LlmProvider {
  GOOGLE
  ANTHROPIC
  OPENAI
}

enum AuditActionType {
  BOT_CREATED
  BOT_DELETED
  CLIENT_CREATED
  CLIENT_UPDATED
  CLIENT_DELETED
  BOT_ACTIVATED
  BOT_DEACTIVATED
  BOT_CONFIG_UPDATED
  KB_UPDATED
  QUOTA_CHANGED
  LEAD_STATUS_CHANGED
  IMPERSONATION_STARTED
  IMPERSONATION_ENDED
  ALERT_ACKNOWLEDGED
  ALERT_RESOLVED
  USER_INVITED
  USER_REMOVED
  SUBSCRIPTION_CHANGED
  EMAIL_SENT
  CREDENTIALS_RESENT
  PASSWORD_CHANGED
  LEADS_EXPORTED
  CRM_INTEGRATION_UPDATED
  CRM_INTEGRATION_TESTED
  CRM_SYNC_RETRIED
  OTHER
}

enum InsightStatus {
  PENDING
  APPLIED
  DISMISSED
  IGNORED
}

enum InsightCategory {
  KB_GAP
  CONVERSION_LEAK
  CONTENT_OPPORTUNITY
  CONFIG_TWEAK
  COMPETITIVE_INTEL
}

enum PlanKey {
  STARTER
  PRO
  BUSINESS
}

enum SupportTier {
  STANDARD
  PRIORITY
  PRIORITY_24H
}

// ─── NextAuth Required Models ─────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id                    String    @id @default(cuid())
  name                  String?
  email                 String    @unique
  emailVerified         DateTime?
  image                 String?
  password              String?
  passwordResetRequired Boolean   @default(false)
  sessionVersion        Int       @default(1)
  phone                 String?
  role                  Role      @default(ORG_MEMBER)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  lastDashboardVisit    DateTime?

  accounts        Account[]
  sessions        Session[]
  orgMemberships  OrgMember[]
  resetTokens     PasswordResetToken[]
  notifications   Notification[]
  tickets         Ticket[]
  ticketMessages  TicketMessage[]
  assignedTasks   Task[]               @relation("TaskAssignee")
  osAssignedLeads OsLead[]             @relation("OsLeadAssignee")
  osActivities    OsLeadActivity[]     @relation("OsActivityPerformer")
  osTimeEntries   OsTimeEntry[]        @relation("OsTimeEntryUser")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Modelos de Negocio ───────────────────────────────────────────────────────

model Organization {
  id                    String            @id @default(cuid())
  companyName           String
  slug                  String            @unique
  logoUrl               String?
  analyticsPropertyId   String?
  siteUrl               String?
  n8nWorkflowIds        String[]
  onboardingCompleted   Boolean           @default(false)
  whatsapp              String?
  notificationPrefs     Json?
  leadNotificationEmail String?
  leadNotificationMode  NotificationMode? @default(IMMEDIATE)
  createdAt             DateTime          @default(now())

  // Health Score: connection status
  // Structure: { ga4: {connected, lastSync}, searchConsole: {...}, ... }
  dataConnections Json? @default("{\"ga4\":{\"connected\":false,\"lastSync\":null},\"searchConsole\":{\"connected\":false,\"lastSync\":null},\"googleBusinessProfile\":{\"connected\":false,\"lastSync\":null},\"whatsappBusiness\":{\"connected\":false,\"lastSync\":null},\"afip\":{\"connected\":false,\"lastSync\":null},\"pixel\":{\"connected\":false,\"lastSync\":null}}")

  // Google reputation. Manual first, API when Reviews Engine is sold.
  googleRating          Float?
  googleReviewsCount    Int?      @default(0)
  googleRatingUpdatedAt DateTime?

  // Google Business Profile read-only integration
  gbpAccountId      String?
  gbpLocationId     String?
  gbpAccessToken    String?   @db.Text
  gbpRefreshToken   String?   @db.Text
  gbpTokenExpiresAt DateTime?
  gbpConnectedAt    DateTime?
  googleMapsPlaceId String?

  // Tiendanube integration
  tiendanubeStoreId     Int?
  tiendanubeAccessToken String?   @db.Text
  tiendanubeStoreUrl    String?
  tiendanubeConnectedAt DateTime?

  // Email Marketing (WIRE module)
  brevoListId Int?

  // Agenda Inteligente (Cal.com)
  calComApiKey   String? @db.Text
  calComUsername String?
  calComEmbedUrl String?

  // Weekly AIBrief cache
  cachedExecutiveBrief        String?   @db.Text
  cachedExecutiveBriefAt      DateTime?
  executiveBriefRegenerations Int       @default(0)

  // B6.2 — opt-out del reporte ejecutivo semanal por email. Se setea desde el
  // link de unsubscribe del propio mail (1-click). El cron de envío respeta este
  // flag antes de mandar.
  executiveReportOptOut Boolean @default(false)

  // Client profile (admin-managed). city la captura el creador pero hoy la
  // action no la persiste; internalNotes se muestra en OverviewTab (hoy placeholder).
  city          String?
  internalNotes String?

  // Avatar del cliente. avatarInitials es editable a mano (máx 2 chars validados
  // en la app), NO se deriva del companyName; null cae al fallback de la app.
  avatarEmoji    String?
  avatarImageUrl String?
  avatarInitials String?

  // Soft-delete de cliente. null = activo; con fecha = archivado/eliminado
  // (recuperable). Nunca hard delete.
  deletedAt DateTime?

  members           OrgMember[]
  services          Service[]
  projects          Project[]
  messages          Message[]
  invoices          Invoice[]
  notifications     Notification[]
  clientAssets      ClientAsset[]
  subscription      Subscription?
  brandProfile      ClientBrandProfile?
  tickets           Ticket[]
  premiumModules    OrganizationModule[]
  emailContacts     EmailContact[]
  emailCampaigns    EmailCampaign[]
  onboardingTasks   OnboardingTask[]
  botConfig         BotConfig?
  crmIntegration    CrmIntegration?
  briefSnapshots    ExecutiveBriefSnapshot[]
  weeklyReportLogs  WeeklyReportLog[]
  businessMetrics   BusinessMetric[]
  pageViews         PageView[]
}

// Histórico semanal del executive brief. Aditivo al cache vigente en Organization
// (cachedExecutiveBrief*) — no lo reemplaza. Un snapshot por org por semana ISO
// (periodKey calculado en TZ-AR). Si la org regenera N veces dentro de la misma
// semana, el snapshot se sobrescribe (upsert) y queda el último válido. Guarda
// SOLO agregados (sin PII ni leads crudos).
model ExecutiveBriefSnapshot {
  id             String   @id @default(cuid())
  organizationId String
  content        String   @db.Text
  healthScores   Json
  weekResults    Json
  periodKey      String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, periodKey])
  @@index([organizationId, createdAt])
}

// B6.2 — log de envíos del reporte ejecutivo semanal.
// Idempotencia: unique en (orgId, periodKey) — una sola entrega por org por
// semana ISO. Si el cron corre dos veces o falla a mitad, reintenta solo las
// que están en FAILED o no existen; las SENT se saltean.
// Estados terminales: SENT, FAILED, SKIPPED_*. Intermedio: PENDING (mientras
// el send está en vuelo).
enum WeeklyReportStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_PLAN
  SKIPPED_OPTOUT
  SKIPPED_NO_RECIPIENT
  SKIPPED_NO_DATA
}

model WeeklyReportLog {
  id             String             @id @default(cuid())
  organizationId String
  periodKey      String
  status         WeeklyReportStatus @default(PENDING)
  recipientEmail String?
  messageId      String?
  errorMessage   String?            @db.Text
  attempts       Int                @default(0)
  sentAt         DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, periodKey])
  @@index([status])
  @@index([periodKey])
}

model OrgMember {
  id                          String   @id @default(cuid())
  userId                      String
  organizationId              String
  role                        OrgRole  @default(ADMIN)
  joinedAt                    DateTime @default(now())
  emailNotificationsOnMessage Boolean  @default(true)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model Service {
  id        String        @id @default(cuid())
  type      ServiceType
  status    ServiceStatus @default(ACTIVE)
  startDate DateTime      @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Project {
  id                   String        @id @default(cuid())
  name                 String
  description          String?
  status               ProjectStatus @default(PLANNING)
  agreedAmount         Decimal?      @db.Decimal(10, 2)
  monthlyRate          Decimal?      @db.Decimal(10, 2)
  maintenanceStartDate DateTime?
  deliveredAt          DateTime?
  estimatedEndDate     DateTime?
  osLeadId             String?       @unique

  organizationId      String
  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks               Task[]
  osLead              OsLead?                @relation(fields: [osLeadId], references: [id])
  paymentMilestones   OsPaymentMilestone[]
  maintenancePayments OsMaintenancePayment[]
  timeEntries         OsTimeEntry[]

  @@index([organizationId])
}

model Task {
  id              String          @id @default(cuid())
  title           String
  description     String?
  status          TaskStatus      @default(TODO)
  dueDate         DateTime?
  approvalStatus  ApprovalStatus?
  rejectionReason String?         @db.Text
  estimatedHours  Float?
  position        Int?            @default(0)
  assignedToId    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo    User?          @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  notifications Notification[]
  osTimeEntries OsTimeEntry[]

  @@index([assignedToId])
}

model Message {
  id        String   @id @default(cuid())
  content   String   @db.Text
  fromAdmin Boolean  @default(false)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Plan {
  id              String  @id @default(cuid())
  key             PlanKey @unique
  name            String
  monthlyPrice    Decimal @db.Decimal(10, 2)
  setupFloorPrice Decimal @db.Decimal(10, 2)

  // 7 dimensiones de gating (server-enforced en B4.2)
  quota          Int
  llmModel       String
  tools          String[]
  maxDomains     Int?
  reportsEnabled Boolean  @default(false)
  insightEnabled Boolean  @default(false)
  crmEnabled     Boolean  @default(false)

  supportTier SupportTier @default(STANDARD)
  active      Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  subscriptions        Subscription[]
  pendingSubscriptions Subscription[] @relation("PendingPlan")

  @@map("plan")
}

model Subscription {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId         String?
  plan           Plan?        @relation(fields: [planId], references: [id])

  // ─── B4.3: Billing override (separado del gating) ───
  // El gating del bot SIEMPRE lee del Plan (via getPlanForOrg).
  // El billing/facturación lee priceOverride si está seteado y la fecha
  // de vencimiento no pasó. NO mezclar — son responsibilities distintas.
  priceOverride  Decimal?  @db.Decimal(10, 2)
  overrideUntil  DateTime?
  overrideReason String?   @db.Text

  // ─── B4.3: Scheduling de cambio de plan ───
  // Upgrade = se aplica inmediato (sortOrder mayor del nuevo Plan).
  // Downgrade = se difiere al inicio del próximo ciclo (sortOrder menor).
  // getPlanForOrg aplica lazy el pending cuando la fecha pasó (sin cron).
  pendingPlanId          String?
  pendingPlan            Plan?     @relation("PendingPlan", fields: [pendingPlanId], references: [id])
  pendingPlanEffectiveAt DateTime?
  lastPlanChangedAt      DateTime?

  status      SubscriptionStatus @default(ACTIVE)
  price       Float
  currency    String             @default("USD")
  renewalDate DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([planId])
  @@index([pendingPlanId])
  @@index([pendingPlanEffectiveAt])
}

model Invoice {
  id          String        @id @default(cuid())
  amount      Float
  currency    String        @default("USD")
  status      InvoiceStatus @default(PENDING)
  dueDate     DateTime
  paidAt      DateTime?
  paymentLink String?
  pdfUrl      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model ContactSubmission {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String?
  company    String?
  service    String?
  message    String   @db.Text
  read       Boolean  @default(false)
  leadStatus String?  @default("NUEVO")
  leadNotes  String?  @db.Text
  createdAt  DateTime @default(now())
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType @default(INFO)
  title     String
  message   String
  read      Boolean          @default(false)
  actionUrl String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // B11.5 — dashboard/layout.tsx:81 hace findMany({where:{organizationId}, orderBy:{createdAt:'desc'}, take:5})
  // en CADA request al /dashboard. Hoy solo PK index → seq scan + sort.
  @@index([organizationId, createdAt(sort: Desc)])
}

model ClientAsset {
  id          String    @id @default(cuid())
  name        String
  url         String
  type        AssetType @default(OTHER)
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model ClientBrandProfile {
  id             String   @id @default(cuid())
  primaryColor   String?
  secondaryColor String?
  toneOfVoice    String?  @db.Text
  targetAudience String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Ticket {
  id             String          @id @default(cuid())
  title          String
  category       TicketCategory  @default(TECHNICAL)
  status         TicketStatus    @default(OPEN)
  priority       TicketPriority  @default(MEDIUM)
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       TicketMessage[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId])
  @@index([userId])
}

model TicketMessage {
  id        String   @id @default(cuid())
  content   String   @db.Text
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([userId])
}

// B11.6 — clientId (FK a User) → organizationId (FK a Organization).
// Tablas vacías al momento de la migración (verificado en pre-flight).
// La métrica es del NEGOCIO (org), no del usuario individual que la captura.
model BusinessMetric {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  month           String
  monthlyVisitors Int
  bounceRate      Float
  avgTicketPrice  Float
  createdAt       DateTime     @default(now())

  @@index([organizationId])
}

model PageView {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  url            String
  duration       Int?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model AgencySettings {
  id                           String   @id @default(cuid())
  agencyName                   String   @default("develOP")
  contactEmail                 String?
  contactWhatsapp              String?
  websiteUrl                   String?
  alertWebhookUrl              String?
  alertOnTickets               Boolean  @default(true)
  alertOnLeads                 Boolean  @default(true)
  alertOnChurn                 Boolean  @default(true)
  alertOnExpiringSubscriptions Boolean  @default(true)
  alertOnClientMessages        Boolean  @default(false)
  osWeeklyDemoTarget           Int      @default(8)
  osTelegramBotToken           String?
  osTelegramChatId             String?
  updatedAt                    DateTime @updatedAt
}

model OnboardingTask {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  category    OnboardingTaskCategory
  title       String
  description String                 @db.Text
  sortOrder   Int

  status        OnboardingTaskStatus @default(PENDING)
  completedAt   DateTime?
  completedById String?
  internalNotes String?              @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, sortOrder])
  @@index([organizationId, status])
}

model OsLead {
  id             String         @id @default(cuid())
  businessName   String
  contactName    String?
  phone          String?
  email          String?
  industry       String?
  zone           String?
  source         String?
  instagramUrl   String?
  currentWebUrl  String?
  googleMapsUrl  String?
  status         LeadStatus     @default(PROSPECTO)
  serviceType    OsServiceType?
  nextFollowUpAt DateTime?
  reactivateAt   DateTime?
  notes          String?
  assignedToId   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  assignedTo User?            @relation("OsLeadAssignee", fields: [assignedToId], references: [id])
  activities OsLeadActivity[]
  demos      OsDemo[]
  dossier    OsLeadDossier?
  project    Project?

  @@index([status])
  @@index([nextFollowUpAt])
  @@index([status, nextFollowUpAt])
  @@index([assignedToId])
}

model OsLeadActivity {
  id            String          @id @default(cuid())
  leadId        String
  channel       ActivityChannel
  result        ActivityResult?
  notes         String?
  performedById String?
  createdAt     DateTime        @default(now())

  lead        OsLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  performedBy User?  @relation("OsActivityPerformer", fields: [performedById], references: [id])

  @@index([leadId, createdAt])
}

model OsDemo {
  id          String         @id @default(cuid())
  leadId      String
  serviceType OsServiceType?
  demoUrl     String
  loomUrl     String?
  sentAt      DateTime       @default(now())
  viewedAt    DateTime?
  notes       String?
  createdAt   DateTime       @default(now())

  lead OsLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model OsLeadDossier {
  id             String       @id @default(cuid())
  leadId         String       @unique
  stage          DossierStage @default(FICHA)
  fichaJson      Json?
  evaluacionJson Json?
  briefJson      Json?
  selfCheckJson  Json?
  draftUrl       String?
  rechazos       Json?
  finalUrl       String? // B5: URL permanente que registra el admin al aprobar (el panel no publica)
  aprobadaAt     DateTime?
  enviadaAt      DateTime? // B5: queda null — lo setea el envío (B6)
  agendaJson     Json? // B7: reunión Cal.com (uid, notas de traspaso, realizada, resultado) — contrato AgendaSchema
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  lead OsLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([stage])
}

model OsPaymentMilestone {
  id        String        @id @default(cuid())
  projectId String
  type      MilestoneType
  amount    Decimal       @db.Decimal(10, 2)
  dueAt     DateTime?
  paidAt    DateTime?
  createdAt DateTime      @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model OsMaintenancePayment {
  id        String    @id @default(cuid())
  projectId String
  month     Int
  year      Int
