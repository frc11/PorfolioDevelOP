// ============================================================
// CHATBOT MODULE
// ============================================================
// All chatbot tables prefixed `chatbot_` via @@map.
// See src/modules/chatbot/README.md for module boundary rules.

model BotConfig {
  id String @id @default(cuid())

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Identidad pública
  slug     String  @unique
  botName  String
  isActive Boolean @default(true)

  // Apariencia básica
  accentColor     String  @default("#06b6d4")
  accentSecondary String?
  chatSurfaceTint String?

  // Avatar
  avatarStyle    String  @default("neuro")
  avatarImageUrl String?
  avatarEmoji    String?

  // Estilo visual extendido
  borderRadius   String @default("medium")
  surfaceStyle   String @default("glass")
  position       String @default("bottom_right")
  fontStyle      String @default("sans")
  bubbleStyle    String @default("rounded")
  intensityLevel BotIntensityLevel @default(MEDIUM)

  // Comportamiento conversacional
  tone             String @default("informal_rioplatense")
  welcomeMessage   String @db.Text
  proactivePrompts Json   @default("[]")
  quickReplies     Json   @default("[]")
  routeColorMap    Json   @default("{}")

  // Derivación a WhatsApp
  whatsappNumber  String?
  whatsappMessage String? @db.Text

  // LLM
  llmProvider     LlmProvider @default(GOOGLE)
  llmModel        String @default("gemini-2.5-flash")
  temperature     Float  @default(0.7)
  maxOutputTokens Int    @default(800)

  // Cuota mensual
  monthlyQuota Int @default(1000)

  // Dominios autorizados a embeber el widget (whitelist)
  allowedDomains String[] @default([])

  // Rubro / industria
  industry String @default("generic")

  // Relaciones
  knowledgeBase KnowledgeBase?
  conversations Conversation[]
  leads         ChatbotLead[]
  quotaUsages   QuotaUsage[]
  events        ChatbotEvent[]
  insights      ChatbotInsight[]
  alerts        BotAlert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@map("chatbot_bot_config")
}

model KnowledgeBase {
  id String @id @default(cuid())

  botConfigId String    @unique
  botConfig   BotConfig @relation(fields: [botConfigId], references: [id], onDelete: Cascade)

  // Secciones markdown (las 6 + forbiddenStatements)
  businessInfo        String @default("") @db.Text
  servicesOrProducts  String @default("") @db.Text
  faq                 String @default("") @db.Text
  policies            String @default("") @db.Text
  salesGuidance       String @default("") @db.Text
  toneExamples        String @default("") @db.Text
  forbiddenStatements String @default("") @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("chatbot_knowledge_base")
}

model Conversation {
  id String @id @default(cuid())

  botConfigId String
  botConfig   BotConfig @relation(fields: [botConfigId], references: [id], onDelete: Cascade)

  // Identificación anónima del usuario
  sessionId   String  @unique
  ipHash      String?
  userAgent   String? @db.Text
  referrerUrl String?
  currentPath String?

  // Lifecycle
  startedAt     DateTime  @default(now())
  lastMessageAt DateTime  @default(now())
  endedAt       DateTime?

  // Métricas denormalizadas (actualizadas en transacción al guardar mensaje)
  messageCount     Int     @default(0)
  tokensIn         Int     @default(0)
  tokensOut        Int     @default(0)
  estimatedCostUsd Decimal @default(0) @db.Decimal(10, 6)

  // Outcome
  leadCaptured Boolean @default(false)

  // Relaciones
  messages ChatMessage[]
  lead     ChatbotLead?
  events   ChatbotEvent[]

  @@index([botConfigId, startedAt])
  @@index([sessionId])
  // B11.5 — multiTenantQueries.ts:57 + queries.ts:17 ordenan por lastMessageAt DESC.
  // Hoy 49 filas → impacto invisible; a 10k filas/bot evita sort en memoria.
  @@index([botConfigId, lastMessageAt(sort: Desc)])
  @@map("chatbot_conversation")
}

model ChatMessage {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    ChatMessageRole
  content String @db.Text

  // Solo para mensajes de assistant
  toolCalls Json?
  tokensIn  Int?
  tokensOut Int?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@map("chatbot_message")
}

model ChatbotLead {
  id String @id @default(cuid())

  botConfigId String
  botConfig   BotConfig @relation(fields: [botConfigId], references: [id], onDelete: Cascade)

  conversationId String?       @unique
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  // Datos capturados
  name    String?
  email   String?
  phone   String?
  // B11.4 — enum-izado. El enum `ChatbotLeadIntent` incluye los valores
  // legacy pre-B5.1 (QUOTE/INFO/DEMO) junto con los nuevos B5.1+
  // (PURCHASE_READY/SCHEDULE_VISIT/QUOTE_REQUEST/HUMAN_REQUEST/SUPPORT/OTHER)
  // para no romper rows pre-existentes (backfill via UPPER(intent)).
  intent  ChatbotLeadIntent?
  message String? @db.Text

  // B5.1 — Categoría DQ. Llenada por el bot al capturar; B5.3 la usa para descalificar.
  category LeadCategory @default(sales)

  // B5.1 — Señales estructuradas detectadas en la conversación.
  // Llenadas por el bot con criterio anti-alucinación (si no apareció, false).
  // providedPhone/providedEmail las DERIVA el handler del input — no del LLM.
  requestedAppointment Boolean @default(false)
  mentionedFinancing   Boolean @default(false)
  mentionedTradeIn     Boolean @default(false)
  askedSpecificModel   Boolean @default(false)
  providedPhone        Boolean @default(false)
  providedEmail        Boolean @default(false)

  // B5.1 — Canal de origen (futuro: 'widget' | 'instagram' | 'whatsapp_inbound' | ...).
  // No se llena aún — el campo queda para que B5+ pueda discriminar sin migración nueva.
  channel String?

  // B5.1 — Campos de scoring que B5.2 va a poblar.
  // Hasta entonces quedan null y son ignorados por la vista actual.
  // scoreSignals guarda el detalle "qué subió/bajó el score" para explicabilidad (B5.4).
  score          Int?
  classification LeadClassification?
  scoreSignals   Json?

  // Notificación
  notificationSent   Boolean   @default(false)
  notificationSentAt DateTime?

  // Estado gestionable por el cliente
  status             ChatbotLeadStatus @default(NEW)
  internalNotes      String?           @db.Text
  lastStatusChangeAt DateTime?

  // Vínculo de conversión → OsLead (flujo de operación/ventas, otro módulo).
  // Guarda el id del OsLead creado al convertir este lead. String simple (sin FK):
  // el badge "Ya convertido" debe ser PERSISTENTE por id — sobrevive cambios o
  // borrado del OsLead — y funciona para leads sin email. No cruza el boundary
  // del módulo chatbot con una relación dura. null = todavía no convertido.
  convertedToOsLeadId String?

  capturedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // B5.8 — historial de syncs a CRM del cliente vía n8n.
  crmSyncAttempts CrmSyncAttempt[]

  @@index([botConfigId, capturedAt])
  @@index([status])
  // B5.1 — índices que B5.2 (scoring) y la vista de 5B van a consumir.
  @@index([classification])
  @@index([score])
  @@index([category])
  @@index([botConfigId, classification, capturedAt(sort: Desc)])
  @@map("chatbot_lead")
}

enum ChatbotLeadStatus {
  NEW
  CONTACTED
  IN_NEGOTIATION
  WON
  LOST
}

// B5.1 — Categoría DQ (B5.3 la usa para descalificar leads no comerciales).
enum LeadCategory {
  sales
  postventa
  employment
  provider
  spam
  other
}

// B5.1 — Clasificación de scoring (B5.2). dq = descalificado por categoría no-sales.
enum LeadClassification {
  hot
  warm
  cold
  dq
}

model ChatbotInsight {
  id              String          @id @default(cuid())
  botConfigId     String
  category        InsightCategory
  status          InsightStatus   @default(PENDING)
  title           String
  description     String          @db.Text
  suggestedAction String          @db.Text
  evidenceCount   Int
  appliedAt       DateTime?
  dismissedAt     DateTime?
  createdAt       DateTime        @default(now())

  botConfig BotConfig @relation(fields: [botConfigId], references: [id], onDelete: Cascade)

  @@index([botConfigId, status, createdAt])
  @@map("chatbot_insights")
}

model QuotaUsage {
  id String @id @default(cuid())

  botConfigId String
  botConfig   BotConfig @relation(fields: [botConfigId], references: [id], onDelete: Cascade)

  year  Int
  month Int // 1-12

  conversationsCount Int     @default(0)
  tokensIn           Int     @default(0)
  tokensOut          Int     @default(0)
  costUsd            Decimal @default(0) @db.Decimal(10, 4)

  alert80Sent   Boolean   @default(false)
  alert80SentAt DateTime?
  degradedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([botConfigId, year, month])
  @@index([botConfigId])
  @@map("chatbot_quota_usage")
}

model ChatbotEvent {
  id             String   @id @default(cuid())
  botConfigId    String
  type           String // ej: "chat.message_received", "chat.lead_captured", "error.llm_failed"
  level          ChatbotEventLevel
  conversationId String?
  message        String   @db.Text
  metadata       Json?
  createdAt      DateTime @default(now())

  botConfig    BotConfig     @relation(fields: [botConfigId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([botConfigId, createdAt(sort: Desc)])
  @@index([level, createdAt(sort: Desc)])
  // B11.5 — detectBotIssues.ts ejecuta 6 queries `where: { botConfigId, type, createdAt: { gte } }`.
  // El index actual (botConfigId, createdAt) traía superset y filtraba `type` en memoria.
  // Con este nuevo, el cron de detección pasa de seq tail-filter a index scan directo.
  @@index([botConfigId, type, createdAt(sort: Desc)])
  @@map("chatbot_events")
}

model BotAlert {
  id String @id @default(cuid())

  botConfigId String
  botConfig   BotConfig @relation(fields: [botConfigId], references: [id], onDelete: Cascade)

  type     BotAlertType
  severity BotAlertSeverity
  status   BotAlertStatus   @default(PENDING)

  title       String
  description String @db.Text
  metadata    Json   @default("{}")

  emailSent   Boolean   @default(false)
  emailSentAt DateTime?

  acknowledgedAt DateTime?
  acknowledgedBy String?

  resolvedAt DateTime?
  resolvedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([botConfigId, status])
  @@index([status, createdAt])
  @@map("chatbot_bot_alert")
}

model AdminAuditLog {
  id String @id @default(cuid())

  userId    String
  userEmail String?
  userName  String?

  actionType AuditActionType
  action     String
  targetType String
  targetId   String

  diff     Json @default("{}")
  metadata Json @default("{}")

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([actionType, createdAt])
  @@map("admin_audit_log")
}

// ─── B5.8 — CRM Integration ───────────────────────────────────────────────────
// Sync de leads del chatbot al CRM del cliente vía n8n. Una integración por org.
// Regla absoluta: el lead se guarda en DB ANTES de intentar el sync. El sync es
// secundario y nunca puede hacer perder un lead. Gateado por plan.crmEnabled.

enum CrmProvider {
  N8N
}

enum CrmSyncStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

model CrmIntegration {
  id String @id @default(cuid())

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  provider   CrmProvider @default(N8N)
  webhookUrl String      @db.Text
  enabled    Boolean     @default(false)

  // Auth opcional vía header (ej. "X-Webhook-Secret"). Secret cifrado AES-256-GCM
  // con env CRM_SECRET_KEY. Si los 4 campos son null, no se manda header de auth.
  secretHeaderName String?
  secretEncrypted  String? @db.Text
  secretIv         String?
  secretTag        String?

  // Última actividad (sanitizada — sin PII en lastErrorMessage).
  lastSyncAt       DateTime?
  lastErrorAt      DateTime?
  lastErrorMessage String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  syncAttempts CrmSyncAttempt[]

  @@map("crm_integration")
}

// Historial de intentos de sync. Los reads aplican stale detection:
// un PENDING/RETRYING con attemptedAt > SYNC_STALE_THRESHOLD_MS se considera FAILED
// (proceso muerto antes de marcar resultado, ej. cold start). Resolución en lectura,
// sin cron — mismo patrón que el decay del score (B5.4).
model CrmSyncAttempt {
  id String @id @default(cuid())

  leadId String
  lead   ChatbotLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  integrationId String
  integration   CrmIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  // Denormalizado por tenant safety: queries por org no requieren join multi-nivel.
  organizationId String

  status        CrmSyncStatus @default(PENDING)
  attemptNumber Int           @default(1)

  httpStatus   Int?
  errorMessage String? @db.Text

  attemptedAt DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int?

  @@index([leadId, attemptedAt(sort: Desc)])
  @@index([integrationId, status, attemptedAt(sort: Desc)])
  @@index([organizationId, status])
  @@map("crm_sync_attempt")
}

// Rate limit compartido entre lambdas (B14.1). Reemplaza el limiter in-memory
// poroso. La atomicidad la garantiza el UPSERT con ON CONFLICT (row lock de
// Postgres) — ver src/lib/rate-limit/limiter.ts.
//
// `key` codifica scope + identificador hasheado: "{scope}:{hash24}".
// `expiresAt` = windowStart + windowMs. La limpieza es lazy: el propio UPSERT
// resetea el bucket cuando la ventana expiró, así la tabla no crece por
// claves muertas dentro de la misma ventana. El índice en expiresAt deja la
// puerta abierta a un job de purga futuro si hace falta.
model RateLimit {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@map("rate_limit")
}
