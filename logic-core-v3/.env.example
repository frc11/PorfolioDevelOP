# .env.example — develOP / Logic Core v3
#
# Copiar este archivo a .env.local y completar los valores reales.
# NUNCA commitear .env o .env.local (deben estar en .gitignore).
#
# Leyenda:
#   REQUERIDA   — la app no funciona sin esta variable
#   OPCIONAL    — feature degrada o usa mock/fallback si está ausente
#   CI/CD       — se setea automáticamente en Netlify, no en .env local
#
# Actualizado: 2026-05-19

# ===========================================
# BASE DE DATOS — Neon PostgreSQL
# ===========================================
# REQUERIDA — Connection string de Neon (sa-east-1)
# Formato: postgresql://[user]:[password]@[host]/[db]?sslmode=require
DATABASE_URL=

# ===========================================
# AUTH — NextAuth v5
# ===========================================
# REQUERIDA — Secret para firmar JWTs. Generar con: openssl rand -base64 32
AUTH_SECRET=

# REQUERIDA — URL canónica de la app (sin trailing slash)
# Local: http://localhost:3000 | Prod: https://tu-dominio.netlify.app
NEXTAUTH_URL=

# OPCIONAL — Alias legacy de AUTH_SECRET (usado como fallback en impersonation)
# No es necesario si AUTH_SECRET está seteado
# NEXTAUTH_SECRET=

# REQUERIDA — Secret para el endpoint de impersonación de admins
IMPERSONATION_SECRET=

# ===========================================
# CHATBOT — LLM Provider
# ===========================================
# OPCIONAL — 'google' (default) | 'anthropic'
# CHATBOT_LLM_PROVIDER=google

# --- Google Vertex AI ---
# REQUERIDA (si CHATBOT_LLM_PROVIDER=google)
# Path al archivo JSON de Service Account (relativo a la raíz del proyecto)
# Ej: ./vertex-credentials.json (debe estar en .gitignore)
GOOGLE_APPLICATION_CREDENTIALS=./vertex-credentials.json

# OPCIONAL — JSON inline del Service Account (alternativa a GOOGLE_APPLICATION_CREDENTIALS)
# Útil en Netlify donde no se puede subir un archivo de credenciales
# GOOGLE_VERTEX_CREDENTIALS_JSON={"type":"service_account",...}

# REQUERIDA (si CHATBOT_LLM_PROVIDER=google) — Project ID de Google Cloud
CHATBOT_GCP_PROJECT_ID=

# REQUERIDA (si CHATBOT_LLM_PROVIDER=google) — Location de Vertex AI
CHATBOT_GCP_LOCATION=us-central1

# OPCIONAL — Google AI API Key (fallback al API simple, sin Vertex)
# CHATBOT_GOOGLE_API_KEY=

# --- Anthropic ---
# REQUERIDA (si CHATBOT_LLM_PROVIDER=anthropic o para AIExecutiveBrief / ResultsInsights)
ANTHROPIC_API_KEY=

# --- Seguridad ---
# REQUERIDA — Salt para hashear IPs (compliance / privacy)
CHATBOT_IP_HASH_SALT=

# ===========================================
# EMAIL
# ===========================================
# Usar Resend (recomendado) o Brevo. Solo una es necesaria.

# --- Resend ---
# REQUERIDA (si se usa Resend)
RESEND_API_KEY=
# REQUERIDA (si se usa Resend) — Email remitente verificado en Resend
# RESEND_FROM_EMAIL=noreply@tu-dominio.com

# --- Brevo ---
# REQUERIDA (si se usa Brevo)
# BREVO_API_KEY=
# REQUERIDA (si se usa Brevo) — Email remitente verificado en Brevo
# BREVO_FROM_EMAIL=hola@develop.com.ar
# OPCIONAL — Nombre del remitente (default: develOP)
# BREVO_FROM_NAME=develOP

# REQUERIDA — Email donde llegan alertas técnicas del sistema
# (bot caído, quota exhausted, errores críticos del chatbot)
DEVELOP_ALERTS_EMAIL=

# ===========================================
# ANALYTICS & SEO — Google APIs
# ===========================================
# OPCIONAL — Service Account JSON para Google Analytics Data API y Search Console
# Si no está, los dashboards de Analytics/SEO muestran datos mock o vacíos
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# OPCIONAL — API Key para PageSpeed Insights
# Si no está, la card de PageSpeed no carga
# GOOGLE_PAGESPEED_API_KEY=

# OPCIONAL — OAuth2 para Google Business Profile (módulo reseñas)
# GOOGLE_BUSINESS_PROFILE_CLIENT_ID=
# GOOGLE_BUSINESS_PROFILE_CLIENT_SECRET=
# GOOGLE_BUSINESS_PROFILE_REDIRECT_URI=http://localhost:3000/api/auth/google-business/callback

# ===========================================
# INTEGRACIONES — E-commerce
# ===========================================
# OPCIONAL — OAuth para Tiendanube (módulo tienda conectada)
# TIENDANUBE_CLIENT_ID=
# TIENDANUBE_CLIENT_SECRET=

# ===========================================
# AUTOMATIZACIONES — n8n
# ===========================================
# OPCIONAL — URL base de la instancia n8n (para gestión de workflows)
# N8N_API_URL=https://tu-instancia.n8n.cloud/api/v1
# N8N_API_KEY=

# OPCIONAL — Webhook de contacto (server-side, usado en lib/n8n.ts)
# N8N_CONTACT_WEBHOOK_URL=

# OPCIONAL — Webhook de contacto (client-side, usado en Footer.tsx)
# NEXT_PUBLIC_N8N_CONTACT_WEBHOOK_URL=

# ===========================================
# NOTIFICACIONES — Telegram (alertas internas)
# ===========================================
# OPCIONAL — Bot de Telegram para alertas del cron de follow-up de leads
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ===========================================
# CRON JOBS
# ===========================================
# REQUERIDA — Secret para autenticar los endpoints /api/cron/*
# En Netlify se setea en las scheduled functions. Local no es necesario.
# CRON_SECRET=

# ===========================================
# PUBLIC (expuestas al cliente — prefijo NEXT_PUBLIC_)
# ===========================================
# REQUERIDA — WhatsApp number para CTAs (sin +, formato internacional)
NEXT_PUBLIC_WHATSAPP_NUMBER=5493815555555

# REQUERIDA — URL pública canónica de la app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OPCIONAL — Sentry DSN (monitoreo de errores)
# NEXT_PUBLIC_SENTRY_DSN=

# ===========================================
# MONITORING — Sentry (configuración de build)
# ===========================================
# OPCIONAL — Solo necesario para subir source maps en deploy
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# ===========================================
# CI/CD — Se setea automáticamente en Netlify
# ===========================================
# NEXT_PUBLIC_BUILD_TIME — Timestamp de build, inyectado por next.config.ts
