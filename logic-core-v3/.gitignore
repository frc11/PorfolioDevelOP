# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — block anything with .env, environment, or enviroment in the name
# Pattern `.env*` only matches files starting with ".env" → typo files like
# `enviroment.env` slip through. The extra patterns below catch those too.
.env*
*.env
*environment*
*enviroment*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
vertex-credentials.json
*.json.credentials

vertex-credentials.json


test-results/
playwright-report/

# DB backups (B14.3) — contienen PII, NUNCA commitear.
# El workflow GH Actions guarda los dumps como artifacts cifrados; los locales
# quedan en backups/ y nunca tocan el repo.
backups/
*.sql
*.sql.gz
*.dump
*.gpg
# Excepción: las migrations de Prisma son código del repo, no dumps con PII.
!prisma/migrations/**/*.sql

# Scripts efímeros de QA/seed/probe por sprint (_p02-*, _p03-*, etc.)
scripts/_p[0-9][0-9]-*
# Lane Resultados — seed efímero de QA para /analisis (no se mergea)
scripts/dev/_seed-resultados-qa.ts
